0x827C   # p02:81F8 entrada 6 de la tabla de 0x81FB (call 0x4084 en 0x81F8)
0x82D8   # p02:81F8 entrada 9 de la tabla de 0x81FB (call 0x4084 en 0x81F8)
0x82FE   # vuelta de p03:ABB9 ld hl,0x82FE / push hl antes de call L_4084
0x8308   # p02:81F8 entrada 8 de la tabla de 0x81FB (call 0x4084 en 0x81F8)
0x8366   # p02:81F8 entrada 13 de la tabla de 0x81FB (call 0x4084 en 0x81F8)
0x83B1   # 40 bytes: X = IX+4 - 8, L_5C92 y busca en la tabla de 0xE305; nadie lo llama
0x83CD   # 12 bytes: A = IX+4 + 0x30, y si no pasa de 0xA0 vuelve a L_83B8; nadie lo llama

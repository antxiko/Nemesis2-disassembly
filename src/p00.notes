C 0x5FE9 0xF000 = 0xFF
C 0x4457 un byte hacia delante
C 0x4458 al otro hacia atras
C 0x4620 el bit de la derecha sale por el acarreo
C 0x4622 y entra por la derecha de A
C 0x4625 el byte al reves
C 0x4627 cuantos quedan
C 0x4649 IX lo cambia copia_a_vram
C 0x4653 x 8 + el tercio
C 0x4668 desde 0xE800

L 0x6E36 orden_ed 0xED: la envolvente de volumen (IX+21-IX+24)
L 0x6E7B orden_ee 0xEE: sin envolvente de volumen
L 0x6E81 orden_ef 0xEF: el desafino (IX+25)
L 0x6E8C orden_f0 0xF0: sin desafino
L 0x6E92 orden_f1 0xF1: el vibrato (periodo IX+1B, amplitud IX+1C)
L 0x6EAD orden_f2 0xF2: sin vibrato
L 0x6EB7 orden_f3 0xF3: la espera del vibrato (IX+1A)
L 0x6EC6 orden_f4 0xF4: el vibrato sin espera
L 0x6ECC orden_f5 0xF5: notas con periodo directo
L 0x6ED2 orden_f6 0xF6: sin periodo directo
L 0x6EDC orden_f7 0xF7: IX+0E bit 5
L 0x6EE2 orden_f8 0xF8: la forma de onda del SCC (p04:6000) en IX+26
L 0x6EFC orden_f9 0xF9: llama a otro trozo de partitura (vuelta en IX+07)
L 0x6F07 orden_fa 0xFA: vuelve de la llamada
L 0x6F0F orden_fb 0xFB: repite (veces, direccion) con la cuenta IX+05
L 0x6F1B salto HL = la direccion que va detras, menos 1
L 0x6F29 orden_fc 0xFC: repite (veces, direccion) con la cuenta IX+06
L 0x6F3E orden_fd 0xFD: salta a la direccion que va detras
L 0x6F41 orden_fe 0xFE: el modo IX+09 (4: bateria, todo a cero)
L 0x6F55 octava_o_volumen 0xD0-0xD5: la octava (IX+16); 0xD6-0xDF: el volumen relativo
L 0x6F6A registros_de_sonido los del PSG y los del SCC
L 0x6F71 registros_del_psg tonos y volumenes, el ruido, la envolvente y el mezclador
L 0x6F7E tonos_del_psg los periodos y volumenes de los 3 canales del PSG (0xE00A, 0xE032, 0xE05A)
